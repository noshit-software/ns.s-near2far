# Demo stack — isolated ports/DB/volumes from the real .env stack. See docker-compose.demo.yml.

# --- Backend ---
BACKEND_PORT=5121

# --- Dashboard ---
DASHBOARD_PORT=5120

# --- Postgres ---
POSTGRES_USER=near2far_demo
POSTGRES_PASS=
POSTGRES_DB=near2far_demo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Web Push ---
# Left blank on purpose — no real push endpoint for a demo; "Enable trip alerts" just hides itself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:demo@near2far.family

# --- CORS ---
CORS_ORIGINS=
