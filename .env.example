# --- Backend ---
BACKEND_PORT=5101

# --- Dashboard ---
DASHBOARD_PORT=5100

# --- Postgres (pgvector + AGE) ---
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_DB=near2far
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Traccar ---
# Where the traccar container forwards each new position. Local all-in-one
# docker-compose dev (backend also in this compose file): http://backend:8000/api/traccar/forward
# VPS (backend runs via pm2, not in this compose file): http://host.docker.internal:5101/api/traccar/forward
TRACCAR_FORWARD_URL=http://backend:8000/api/traccar/forward

# --- Web Push (trip-end alerts) ---
# Generate with: uv run --with pywebpush vapid --gen (from backend/), then paste the
# printed "Public Key" / "Private Key" (base64url, no PEM headers) below. Leave blank to
# disable push — the dashboard's "Enable trip alerts" button hides itself in that case.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@near2far.family

# --- CORS ---
# Comma-separated allowed origins, e.g. https://near2far.family,https://gps.near2far.family
# Leave blank for local dev — defaults to allowing any origin ("*"). Set this in production;
# auth here is a Bearer/Basic header (not a cookie), so a wildcard doesn't expose classic CSRF,
# but there's no reason a single-domain PWA needs to allow every origin either.
CORS_ORIGINS=
