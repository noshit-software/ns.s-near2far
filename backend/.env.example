# Used when running the backend directly via pm2 (ecosystem.config.js), not in Docker.
# Copy to backend/.env and fill in — must match the db container's credentials
# (root .env POSTGRES_USER/POSTGRES_PASS/POSTGRES_DB) since the db still runs via
# `docker compose up -d db`, with its port published to 127.0.0.1 only.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_DB=near2far
